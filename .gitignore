# Backend configuration is versioned; never place credentials in backend.tf.
# Terraform state and plans
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log

# Terraform working directories and dependency locks
.terraform/
.terraform.tfstate.lock.info

# Variable files may contain secrets
*.tfvars
*.tfvars.json
!*.tfvars.example

# CLI configuration and overrides
.terraformrc
terraform.rc
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local environment, editor, and operating-system files
.envrc
venv/
.vscode/
.idea/
.DS_Store
# pi-project-queue local memory
.pi/project-memory/
